# Copy this file to .env (which is gitignored) and fill in a real value before running
# `docker compose up`.
#
# Generate one with (must be base64, not hex):
#   openssl rand -base64 32
DISCOVERY_SECRET_KEY=
# Required only on the first start with an empty user store. Use a unique password
# with at least 8 characters; do not commit the real value.
DISCOVERY_BOOTSTRAP_ADMIN_PASSWORD=
